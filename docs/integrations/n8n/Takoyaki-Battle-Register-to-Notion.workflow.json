    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst required = ['name', 'line_name', 'gender', 'birthday', 'phone', 'email', 'emergency_name', 'emergency_phone'];\nconst missing = required.filter((key) => !String(body[key] ?? '').trim());\nconst gender = String(body.gender ?? '').trim() === '不公開' ? '其他' : String(body.gender ?? '').trim();\n\nif (missing.length > 0 || body.agree !== true) {\n  return [{\n    json: {\n      valid: false,\n      statusCode: missing.length > 0 ? 400 : 403,\n      message: missing.length > 0\n        ? `Missing required fields: ${missing.join(', ')}`\n        : 'Terms must be agreed',\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    payload: {\n      name: String(body.name).trim(),\n      line_name: String(body.line_name).trim(),\n      gender,\n      birthday: String(body.birthday).trim(),\n      phone: String(body.phone).trim(),\n      email: String(body.email).trim(),\n      emergency_name: String(body.emergency_name).trim(),\n      emergency_phone: String(body.emergency_phone).trim(),\n      agree: true,\n      pageUrl: String(body.pageUrl ?? '').trim(),\n      source: String(body.source ?? 'website-register').trim(),\n      timestamp: body.timestamp || new Date().toISOString(),\n    },\n  },\n}];"
      },
