      "id": "c78e5599-d30f-4fc7-b5db-e1f2c1e0f28d",
      "name": "Get Existing Votes",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [-440, -120],
      "alwaysOutputData": true,
      "credentials": {
        "notionApi": {
          "id": "",
          "name": "Notion account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const payload = $('Validate Vote').first().json.payload;\nconst items = $input.all();\n\nfunction plainText(parts = []) {\n  return parts.map((part) => part.plain_text ?? part.text?.content ?? '').join('').trim();\n}\n\nfunction readNotionProperty(prop) {\n  if (!prop) return '';\n  if (typeof prop === 'string' || typeof prop === 'number' || typeof prop === 'boolean') return String(prop).trim();\n  if (prop.type === 'title') return plainText(prop.title);\n  if (prop.type === 'rich_text') return plainText(prop.rich_text);\n  if (prop.type === 'select') return String(prop.select?.name ?? '').trim();\n  if (prop.type === 'number') return prop.number == null ? '' : String(prop.number).trim();\n  return '';\n}\n\nfunction readUserId(json) {\n  if (!json) return '';\n  if (json['LINE User ID']) return readNotionProperty(json['LINE User ID']);\n  if (json.properties?.['LINE User ID']) return readNotionProperty(json.properties['LINE User ID']);\n  if (json.name) return String(json.name).trim();\n  return '';\n}\n\nconst alreadyVoted = items.some((item) => readUserId(item.json) === payload.userId);\n\nreturn [{\n  json: {\n    alreadyVoted,\n    payload,\n  },\n}];"
      },
