    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst userId = String(body.userId ?? '').trim();\nconst targetPlayerId = String(body.targetPlayerId ?? '').trim();\n\nif (!userId || !targetPlayerId) {\n  return [{\n    json: {\n      valid: false,\n      statusCode: 400,\n      message: 'Missing userId or targetPlayerId',\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    payload: {\n      userId,\n      displayName: String(body.displayName ?? '').trim(),\n      pictureUrl: String(body.pictureUrl ?? '').trim(),\n      targetPlayerId,\n      votedAt: body.votedAt || new Date().toISOString(),\n    },\n  },\n}];"
      },
      "id": "245eb171-cd73-4b86-a1bb-f8fc6efa0194",
      "name": "Validate Vote",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
